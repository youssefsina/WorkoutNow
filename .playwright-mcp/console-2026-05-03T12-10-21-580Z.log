        .specimen-wrap { display: none; }
        @media (min-width: 1024px) { .specimen-wrap { display: block; } }

        .specimen {
          border: 1px solid rgba(255,255,255,0.1);
          border-radius: 2px;
          overflow: hidden;
          background: rgba(255,255,255,0.015);
          position: relative;
          transition: border-color 0.25s, transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
        }
        .specimen:hover { border-color: rgba(255,255,255,0.18); }

        /* corner crosses (gallery feel) */
        .specimen::before,
        .specimen::after {
          content: &#x27;&#x27;;
          position: absolute;
          width: 8px;
          height: 8px;
          background:
            linear-gradient(rgba(255,255,255,0.3), rgba(255,255,255,0.3)) center / 100% 1px no-repeat,
            linear-gradient(rgba(255,255,255,0.3), rgba(255,255,255,0.3)) center / 1px 100% no-repeat;
          pointer-events: none;
        }
        .specimen::before { top: -4px; left: -4px; }
        .specimen::after  { bottom: -4px; right: -4px; }

        .specimen-header {
          padding: 0.875rem 1.5rem;
          border-bottom: 1px solid rgba(255,255,255,0.06);
          display: flex; align-items: center; justify-content: space-between;
        }
        .specimen-dots { display: flex; gap: 5px; align-items: center; }
        .specimen-dot { width: 6px; height: 6px; border-radius: 50%; }
        .specimen-dot-accent { background: #6366f1; box-shadow: 0 0 8px rgba(99,102,241,0.6); }
        .specimen-dot-dim    { background: rgba(255,255,255,0.18); }
        .specimen-dot-ghost  { background: rgba(255,255,255,0.06); }

        .specimen-art {
          padding: 1.5rem 1.5rem 0.75rem;
          background:
            linear-gradient(180deg, rgba(99,102,241,0.04) 0%, transparent 100%),
            radial-gradient(ellipse 60% 60% at 50% 0%, rgba(99,102,241,0.06) 0%, transparent 70%);
          border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .specimen-art-svg {
          width: 100%; height: auto; display: block;
        }

        .specimen-meta {
          padding: 1rem 1.5rem;
          border-bottom: 1px solid rgba(255,255,255,0.06);
          display: grid; gap: 0.5rem;
        }
        .specimen-meta-row {
          display: flex; align-items: baseline; justify-content: space-between;
          gap: 1rem;
        }
        .specimen-meta-label {
          font-size: 0.58rem; letter-spacing: 0.28em;
          text-transform: uppercase; color: rgba(255,255,255,0.32);
        }
        .specimen-meta-value {
          font-family: &#x27;Space Grotesk&#x27;, sans-serif;
          font-size: 0.78rem; letter-spacing: -0.01em;
          color: rgba(255,255,255,0.82);
          font-variant-numeric: tabular-nums;
        }

        .specimen-footer {
          padding: 0.875rem 1.5rem;
          border-top: 1px solid rgba(255,255,255,0.06);
          display: flex; align-items: center; justify-content: space-between;
          background: rgba(99,102,241,0.04);
          text-decoration: none;
          transition: background 0.2s;
        }
        .specimen-footer:hover { background: rgba(99,102,241,0.1); }
        .specimen-cta {
          display: inline-flex; align-items: center; gap: 0.35rem;
          font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;
          color: #fff; font-weight: 600;
          padding: 0.28rem 0.7rem;
          border: 1px solid rgba(99,102,241,0.6);
          background: rgba(99,102,241,0.15);
          border-radius: 1px;
          transition: all 0.2s;
        }
        .specimen-footer:hover .specimen-cta {
          background: #6366f1;
          border-color: #6366f1;
          box-shadow: 0 0 24px rgba(99,102,241,0.4);
        }

        .specimen-caption {
          display: flex; align-items: center; justify-content: space-between;
          margin-top: 0.875rem;
          font-size: 0.58rem; letter-spacing: 0.22em; text-transform: uppercase;
          color: rgba(255,255,255,0.2);
          padding: 0 0.25rem;
        }
       
